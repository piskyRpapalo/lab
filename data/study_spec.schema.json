{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "variables"],
  "properties": {
    "schema": { "const": "lab.study-spec/1" },
    "variables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TREND_VECTOR", "BASE_MODELS", "RAG_CORPUS", "LORA_ADAPTER", "HARDWARE_MATRIX"],
      "properties": {
        "TREND_VECTOR": { "oneOf": [{ "$ref": "#/$defs/absence" }, { "$ref": "#/$defs/reference" }] },
        "BASE_MODELS": { "oneOf": [{ "$ref": "#/$defs/absence" }, { "$ref": "#/$defs/references" }] },
        "RAG_CORPUS": { "oneOf": [{ "$ref": "#/$defs/absence" }, { "$ref": "#/$defs/references" }] },
        "LORA_ADAPTER": { "oneOf": [{ "$ref": "#/$defs/absence" }, { "$ref": "#/$defs/reference" }] },
        "HARDWARE_MATRIX": { "oneOf": [{ "$ref": "#/$defs/hardware_absence" }, { "$ref": "#/$defs/hardware" }] }
      }
    }
  },
  "$defs": {
    "absence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "cause"],
      "properties": {
        "state": { "const": "NO_DATA" },
        "cause": { "type": "string", "minLength": 1 }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sha256"],
      "properties": {
        "state": { "const": "DECLARED" },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "references": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "sha256"],
      "properties": {
        "state": { "const": "DECLARED" },
        "sha256": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } }
      }
    },
    "hardware_absence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "cause", "rings"],
      "properties": {
        "state": { "const": "NO_DATA" },
        "cause": { "type": "string", "minLength": 1 },
        "rings": { "$ref": "#/$defs/empty_rings" }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "rings"],
      "properties": {
        "state": { "const": "DECLARED" },
        "rings": { "$ref": "#/$defs/machine_rings" }
      }
    },
    "empty_rings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["FORGE", "EDGE", "SANCTUARY"],
      "properties": {
        "FORGE": { "type": "array", "maxItems": 0 },
        "EDGE": { "type": "array", "maxItems": 0 },
        "SANCTUARY": { "type": "array", "maxItems": 0 }
      }
    },
    "machine_rings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["FORGE", "EDGE", "SANCTUARY"],
      "properties": {
        "FORGE": { "$ref": "#/$defs/machines" },
        "EDGE": { "$ref": "#/$defs/machines" },
        "SANCTUARY": { "$ref": "#/$defs/machines" }
      }
    },
    "machines": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hash" }
    },
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
