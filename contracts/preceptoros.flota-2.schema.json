{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preceptoros.org/schemas/preceptoros.flota/2",
  "title": "preceptoros.flota/2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "captured_at",
    "fleet_coverage",
    "map_heartbeat_snapshot",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "preceptoros.flota/2"
    },
    "captured_at": {
      "$ref": "#/$defs/field"
    },
    "fleet_coverage": {
      "$ref": "#/$defs/field"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "map_heartbeat_snapshot": {
      "$ref": "#/$defs/map_snapshot"
    }
  },
  "$defs": {
    "field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estado",
            "valor",
            "fuente",
            "hora"
          ],
          "properties": {
            "estado": {
              "const": "MEDIDO"
            },
            "valor": {},
            "fuente": {
              "type": "string",
              "minLength": 1
            },
            "hora": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estado",
            "causa",
            "fuente",
            "intento"
          ],
          "properties": {
            "estado": {
              "const": "NO_DATA"
            },
            "causa": {
              "type": "string",
              "minLength": 1
            },
            "fuente": {
              "type": "string",
              "minLength": 1
            },
            "intento": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nombre",
        "tamano_bytes",
        "manifest_sha256",
        "parametros",
        "cuantizacion",
        "vram_residente_bytes",
        "capas_gpu"
      ],
      "properties": {
        "nombre": {
          "$ref": "#/$defs/field"
        },
        "tamano_bytes": {
          "$ref": "#/$defs/field"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/field"
        },
        "parametros": {
          "$ref": "#/$defs/field"
        },
        "cuantizacion": {
          "$ref": "#/$defs/field"
        },
        "vram_residente_bytes": {
          "$ref": "#/$defs/field"
        },
        "capas_gpu": {
          "$ref": "#/$defs/field"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placement",
        "identity",
        "runtime",
        "models",
        "memory",
        "disk_available_bytes",
        "system_load",
        "listeners",
        "gateway",
        "sensors",
        "heartbeat"
      ],
      "properties": {
        "placement": {
          "const": "first-row: sovereign inference station"
        },
        "identity": {
          "$ref": "#/$defs/field"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "health"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/field"
            },
            "version": {
              "$ref": "#/$defs/field"
            },
            "health": {
              "$ref": "#/$defs/field"
            }
          }
        },
        "models": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "catalog",
            "active",
            "queue"
          ],
          "properties": {
            "catalog": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/model"
              }
            },
            "active": {
              "$ref": "#/$defs/field"
            },
            "queue": {
              "$ref": "#/$defs/field"
            }
          }
        },
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ram_total_bytes",
            "ram_available_bytes",
            "swap_total_bytes",
            "swap_used_bytes",
            "vram_total_bytes",
            "vram_available_bytes"
          ],
          "properties": {
            "ram_total_bytes": {
              "$ref": "#/$defs/field"
            },
            "ram_available_bytes": {
              "$ref": "#/$defs/field"
            },
            "swap_total_bytes": {
              "$ref": "#/$defs/field"
            },
            "swap_used_bytes": {
              "$ref": "#/$defs/field"
            },
            "vram_total_bytes": {
              "$ref": "#/$defs/field"
            },
            "vram_available_bytes": {
              "$ref": "#/$defs/field"
            }
          }
        },
        "disk_available_bytes": {
          "$ref": "#/$defs/field"
        },
        "system_load": {
          "$ref": "#/$defs/field"
        },
        "listeners": {
          "$ref": "#/$defs/field"
        },
        "gateway": {
          "$ref": "#/$defs/field"
        },
        "sensors": {
          "$ref": "#/$defs/field"
        },
        "heartbeat": {
          "$ref": "#/$defs/field"
        }
      }
    },
    "map_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "q",
        "r",
        "alive",
        "seal",
        "since"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "q": {
          "type": "integer"
        },
        "r": {
          "type": "integer"
        },
        "alive": {
          "const": true
        },
        "seal": {
          "enum": [
            "LIVE",
            "STALE"
          ]
        },
        "since": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "map_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source",
        "measured_at",
        "coverage",
        "nodes"
      ],
      "properties": {
        "schema": {
          "const": "preceptoros.openworld-estado/2"
        },
        "source": {
          "const": "https://api.preceptoros.org/api/v1/latidos"
        },
        "measured_at": {
          "type": "string",
          "format": "date-time"
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "estado",
            "valor",
            "fuente",
            "hora"
          ],
          "properties": {
            "estado": {
              "const": "MEDIDO"
            },
            "valor": {
              "type": "integer",
              "minimum": 1
            },
            "fuente": {
              "type": "string",
              "minLength": 1
            },
            "hora": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/map_node"
          }
        }
      }
    }
  }
}
