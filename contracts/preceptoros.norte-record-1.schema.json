{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://preceptoros.org/schemas/preceptoros.norte-record/1",
  "title": "preceptoros.norte-record/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "round",
    "summary"
  ],
  "properties": {
    "schema": {
      "const": "preceptoros.norte-record/1"
    },
    "round": {
      "$ref": "#/$defs/round"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    }
  },
  "$defs": {
    "measurement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "value",
            "source",
            "observed_at"
          ],
          "properties": {
            "state": {
              "const": "MEASURED"
            },
            "value": {},
            "source": {
              "type": "string",
              "minLength": 1
            },
            "observed_at": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "cause",
            "source",
            "attempted_at"
          ],
          "properties": {
            "state": {
              "const": "NO_DATA"
            },
            "cause": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "attempted_at": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "tick",
        "color",
        "coordinates",
        "frame"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "tick": {
          "$ref": "#/$defs/measurement"
        },
        "color": {
          "$ref": "#/$defs/measurement"
        },
        "coordinates": {
          "$ref": "#/$defs/measurement"
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "v",
            "atoms",
            "bands",
            "sound",
            "seal"
          ],
          "properties": {
            "v": {
              "const": "preceptoros.bubble/1"
            },
            "id": {
              "type": "string"
            },
            "t": {
              "type": "number",
              "minimum": 0
            },
            "cv": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "light": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            },
            "style": {
              "enum": [
                "clear",
                "volume",
                "etch"
              ]
            },
            "atoms": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "k",
                  "r",
                  "i"
                ],
                "properties": {
                  "k": {
                    "type": "string"
                  },
                  "r": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 240
                  },
                  "i": {
                    "type": "array"
                  }
                },
                "additionalProperties": false
              }
            },
            "bands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "change": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "sound": {
              "type": "string",
              "minLength": 1
            },
            "soundCause": {
              "type": "string"
            },
            "motion": {},
            "seal": {
              "enum": [
                "LIVE",
                "STALE",
                "STATIC",
                "SIMULATED",
                "NO_DATA",
                "ERROR"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "sound": {
                    "const": "NO_DATA"
                  }
                },
                "required": [
                  "sound"
                ]
              },
              "then": {
                "required": [
                  "soundCause"
                ],
                "properties": {
                  "soundCause": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "else": {
                "not": {
                  "required": [
                    "soundCause"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "rules_version",
        "device",
        "date",
        "result",
        "seal"
      ],
      "properties": {
        "seed": {
          "$ref": "#/$defs/measurement"
        },
        "rules_version": {
          "$ref": "#/$defs/measurement"
        },
        "device": {
          "$ref": "#/$defs/measurement"
        },
        "date": {
          "$ref": "#/$defs/measurement"
        },
        "result": {
          "$ref": "#/$defs/measurement"
        },
        "seal": {
          "$ref": "#/$defs/measurement"
        }
      }
    }
  }
}
